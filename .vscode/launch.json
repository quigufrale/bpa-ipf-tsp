{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug bpf (WSL)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/bpf",
      "args": ["bench.pfc"],
      "cwd": "${workspaceFolder}/data",
      "environment": [
        { "name": "LANG", "value": "C" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": true,
      "externalConsole": false,
      "console": "integratedTerminal",
      "setupCommands": [
        { "description": "Enable pretty printing", "text": "-enable-pretty-printing" },
        { "description": "Pretty print structures", "text": "set print pretty on" },
        { "description": "Show Fortran-style arrays", "text": "set print array on" }
      ],
    }
  ]
}
